<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Tohotopia.LLMBattle</AssemblyName>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <DefineConstants>$(DefineConstants);TH1_LOADER</DefineConstants>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    <Compile Include="..\Shared\RoomContracts.cs" Link="RoomContracts.cs" />
    <Compile Include="..\Shared\AgentEvents.cs" Link="AgentEvents.cs" />
    <Compile Include="..\Shared\ChatActions.cs" Link="ChatActions.cs" />
    <Compile Include="..\Shared\GameRules.cs" Link="GameRules.cs" />
  </ItemGroup>
  <Target Name="GeneratePackageIdentity" BeforeTargets="CoreCompile">
    <PropertyGroup><PackageBuildId Condition="'$(PackageBuildId)' == ''">$([System.Guid]::NewGuid().ToString('N'))</PackageBuildId></PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)PackageIdentity.g.cs" Lines="namespace TohotopiaMod { internal static class PackageIdentity { internal const string Build = &quot;$(PackageBuildId)&quot;%3B } }" Overwrite="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)PackageIdentity.g.cs" /></ItemGroup>
  </Target>
  <Target Name="WritePackageIdentity" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetDir)package.build" Lines="$(PackageBuildId)" Overwrite="true" />
  </Target>
</Project>
