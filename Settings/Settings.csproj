<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>TH1LLMBattlePanel</AssemblyName>
    <RootNamespace>Settings</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);SETTINGS_APP</DefineConstants>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <CopyOutputSymbolsToPublishDirectory Condition="'$(Configuration)' == 'Release'">false</CopyOutputSymbolsToPublishDirectory>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="TKCode.Arc" Version="1.3.0" />
    <PackageReference Include="TKCode.Arc.Ribbon" Version="1.3.0" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\AgentHost\Models.cs" Link="Models.cs" /></ItemGroup>
  <ItemGroup><AvaloniaResource Include="Assets/app.ico" /></ItemGroup>

<ItemGroup><Compile Include="..\Shared\RoomContracts.cs" Link="RoomContracts.cs" /><Compile Include="..\Shared\AgentEvents.cs" Link="AgentEvents.cs" /></ItemGroup>
  <Target Name="ExcludeReleaseSymbols" AfterTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>

